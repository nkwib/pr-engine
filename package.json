{
  "name": "@prcompass/core",
  "version": "0.1.0",
  "description": "Deterministic engine for PR Compass: commit-mining, churn, cochange, risk-scoring. Zero network, zero LLM, zero DB. Fixture-in, JSON-out.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "code-review",
    "commit-mining",
    "churn",
    "cochange",
    "risk",
    "pull-request",
    "deterministic",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nkwib/prcompass.git",
    "directory": "packages/core"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench --run"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.8",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false
}
