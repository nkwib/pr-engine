{
  "name": "@prcompass/core",
  "version": "0.2.0",
  "description": "Deterministic engine for PR Compass: commit-mining, churn, cochange, risk-scoring. Zero network, zero LLM, zero DB. Fixture-in, JSON-out.",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "BENCHMARKS.md",
    "LICENSE"
  ],
  "keywords": [
    "code-review",
    "commit-mining",
    "churn",
    "cochange",
    "risk",
    "pull-request",
    "deterministic",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nkwib/pr-engine.git"
  },
  "homepage": "https://github.com/nkwib/pr-engine",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "smoke": "node -e \"import('./dist/index.js').then(m => { for (const k of ['analyze', 'mineCommits', 'computeRisk']) { if (typeof m[k] !== 'function') { console.error('smoke: missing export ' + k); process.exit(1); } } console.log('smoke: dist exports OK'); })\"",
    "bench": "vitest bench --run"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@vitest/coverage-v8": "^2.1.8",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false
}
